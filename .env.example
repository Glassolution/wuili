# ── Supabase Principal (Lovable) — OBRIGATÓRIO ────────────────────────────────
# Configure estas variáveis no painel da Vercel: Settings > Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# ── Supabase Secundário (opcional) ────────────────────────────────────────────
VITE_SUPABASE_FUNCTIONS_URL=https://qmjqsbnvgnzzljqbjzia.supabase.co
VITE_SUPABASE_FUNCTIONS_KEY=your_functions_anon_key_here

# ── Resend (Email Service) — BACKEND ONLY ─────────────────────────────────────
# NUNCA exponha esta chave no frontend ou em logs
# Configure no Vercel: Settings > Environment Variables
RESEND_API_KEY=your_resend_api_key_here

# ── PagePilot (geração de páginas de produto com IA) — BACKEND ONLY ───────────
# Usada SOMENTE nas Edge Functions ai-page-create / ai-page-status.
# NUNCA prefixe com VITE_: isso a exporia no bundle do frontend.
# Em produção, configure como secret do Supabase:
#   supabase secrets set PAGEPILOT_API_KEY=...
PAGEPILOT_API_KEY=your_pagepilot_api_key_here

# Base da API do PagePilot. Só mexa se eles mudarem o host/versão.
PAGEPILOT_API_BASE_URL=https://app.pagepilot.ai
